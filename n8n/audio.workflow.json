        "url": "https://openrouter.ai/api/v1/audio/transcriptions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {model:\"openai/whisper-1\",input_audio:{data:$json.audioBase64,format:$json.audioFormat},language:\"fr\"} }}",
        "options": {
          "timeout": 75000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "1ff26aa4-7c8f-436f-9681-73afe369885b",
      "name": "Résultat transcription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sessionId=$('Préparer audio').first().json.sessionId;\nconst result=$input.first().json;\nconst text=typeof result.text==='string'?result.text.trim():'';\nif(result.error)return [{json:{ok:false,sessionId,error:'La transcription OpenRouter est indisponible. Réessayez.',statusCode:502}}];\nif(!text)return [{json:{ok:false,sessionId,error:'Aucune parole reconnue. Réessayez ou écrivez votre message.',statusCode:422}}];\nreturn [{json:{ok:true,sessionId,transcription:text,statusCode:200}}];\n"
      }
    },
    {
      "id": "d92f7a7b-b3c5-4ea6-9565-2ca857ee882b",
      "name": "Répondre audio",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
