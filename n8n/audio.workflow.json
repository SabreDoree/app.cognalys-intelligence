    {
      "id": "6fe19160-7649-46d8-9842-ef3637f72058",
      "name": "Préparer audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item=$input.first();\nconst sessionId=String(item.json.body?.sessionId??item.json.sessionId??'').trim();\nconst fail=(error,statusCode=400)=>[{json:{ok:false,error,statusCode,sessionId}}];\nif(!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(sessionId))return fail('Identifiant de conversation invalide.');\nconst binary=item.binary??{};\nconst property=binary.audio?'audio':binary.data?'data':Object.keys(binary)[0];\nif(!property)return fail('Aucun enregistrement reçu. Envoyez un fichier dans le champ audio.');\nconst meta=binary[property];\nconst extension=String(meta.fileName??'').split('.').pop().toLowerCase();\nconst mime=String(meta.mimeType??'').toLowerCase();\nconst formats={mp3:'mp3',wav:'wav',wave:'wav',m4a:'m4a',mp4:'m4a',ogg:'ogg',oga:'ogg',webm:'webm',flac:'flac',aac:'aac'};\nconst format=formats[extension]||(mime.includes('webm')?'webm':mime.includes('mp4')?'m4a':mime.includes('ogg')?'ogg':mime.includes('wav')?'wav':mime.includes('flac')?'flac':mime.includes('mpeg')?'mp3':mime.includes('aac')?'aac':null);\nif(!format)return fail('Format audio non reconnu. Réessayez depuis le microphone.');\ntry{\n const buffer=await this.helpers.getBinaryDataBuffer(0,property);\n if(!buffer.length)return fail('L’enregistrement est vide. Réessayez.');\n return [{json:{ok:true,sessionId,audioFormat:format,audioBase64:buffer.toString('base64')}}];\n}catch{return fail('Impossible de lire l’enregistrement reçu.');}\n"
      }
    },
    {
      "id": "a0310e9e-adb8-4402-9d02-5547f105478c",
      "name": "Audio valide ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
