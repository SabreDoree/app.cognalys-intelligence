              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "fb03105b-7ba6-4979-9284-f5b61b4a5846",
      "name": "Identité vérifiée",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json;const p=$('Préparer identité').first().json;const u=r.body?.users?.[0];const c=p.claims;const valid=r.statusCode===200&&u&&u.localId===c.sub&&!u.disabled&&(!u.validSince||Number(c.auth_time)>=Number(u.validSince));return [{json:valid?{authenticated:true,uid:u.localId,email:u.email||''}:{authenticated:false,uid:'__invalid',error:'Connexion absente, expirée ou refusée.'}}];"
      }
    },
    {
