      "name": "Préparer identité",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw=$input.first().json;const p=raw.body??raw;let token=String(p.idToken||'');let claims={};try{claims=JSON.parse(Buffer.from(token.split('.')[1],'base64url').toString());}catch{}const now=Math.floor(Date.now()/1000);const expected='cognalys-intelligence-devis';const valid=token.length<10000&&claims.aud===expected&&claims.iss==='https://securetoken.google.com/'+expected&&typeof claims.sub==='string'&&claims.sub.length>0&&claims.exp>now&&claims.iat<=now+60;return [{json:{idToken:valid?token:'invalid',claims:valid?claims:{}}}];"
      }
    },
    {
      "id": "226f5273-04fd-4ec0-8a64-a7398c0585ec",
      "name": "Firebase vérifie le jeton",
      "type": "n8n-nodes-base.httpRequest",
