      "name": "Accès entreprise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const u=$('Identité vérifiée').first().json;if(!u.authenticated)return [{json:{ok:false,authenticated:false,authorized:false,statusCode:401,error:u.error}}];const rows=$input.all().map(i=>i.json).filter(r=>r.uid===u.uid);const m=rows.length===1?rows[0]:null;const authorized=!!(m?.active===true&&/^[a-f0-9]{64}$/.test(m.scope));return [{json:{ok:true,authenticated:true,authorized,uid:u.uid,email:u.email,company:authorized?m.company:'',scope:authorized?m.scope:'',statusCode:authorized?200:403,error:authorized?'':'Compte créé. Votre espace attend son activation par Cognalys.'}}];"
      }
    },
