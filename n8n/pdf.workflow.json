            }
          ]
        },
        "returnAll": true
      },
      "alwaysOutputData": true
    },
    {
      "id": "aba04fd0-4c51-4c21-9e41-59612d474853",
      "name": "Vérifier version et espace",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$('Espace PDF').first().json;const qs=$input.all().map(i=>i.json).filter(r=>r.scope===p.scope&&r.kind==='quote').map(r=>JSON.parse(r.payload));const q=qs.find(q=>q.token===p.params.token);return [{json:q?{allowed:true,token:q.token,numero:q.numero}:{allowed:false,error:'PDF introuvable dans cet espace.'}}];"
      }
    },
