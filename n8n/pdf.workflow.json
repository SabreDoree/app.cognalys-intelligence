          "mode": "id",
          "value": "8aCc7MSHqBrdBtGH"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "scope",
              "condition": "eq",
              "keyValue": "={{ $('Espace PDF').first().json.scope }}"
            },
